# snesmac SNES-side build. Calypsi C -> 65816, same toolchain as snespico8.
# M0: hello (prove the build plumbing). Later: the 68000 core (Musashi via
# Calypsi) + the Mac machine glue.
#
# Reuses snespico8's vendored Calypsi install for now (override CALDIR to point
# elsewhere once snesmac vendors its own).
CALDIR ?= ../../snespico8/tools/calypsi-65816-5.17
CC := $(CALDIR)/bin/cc65816
AS := $(CALDIR)/bin/as65816
LN := $(CALDIR)/bin/ln65816
MESEN := /Applications/Mesen.app/Contents/MacOS/Mesen
BUILD := build

MODEL := --code-model=large --data-model=large
OPT ?= -O2
CFLAGS = --core=65816 --target=snes $(MODEL) --no-ppu-mul $(OPT) -I. --list-file=$(@:.o=.lst)
AFLAGS := --core=65816 --target=SNES $(MODEL)
LNFLAGS := calypsi/linker.scm --output-format=raw --rtattr exit=simplified \
           $(CALDIR)/lib/clib-lc-ld-snes-noppu.a

.PHONY: hello test-hello clean
hello: $(BUILD)/hello.sfc

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/header.o: calypsi/header.s | $(BUILD)
	$(AS) -o $@ $< $(AFLAGS)

$(BUILD)/mailbox.o: calypsi/mailbox.c calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ $< $(CFLAGS)

$(BUILD)/hello.o: hello.c calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ $< $(CFLAGS)

$(BUILD)/hello.raw: $(BUILD)/header.o $(BUILD)/mailbox.o $(BUILD)/hello.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/hello.map $^

$(BUILD)/hello.sfc: $(BUILD)/hello.raw tools/raw2sfc.py
	python3 tools/raw2sfc.py $< $@

test-hello: $(BUILD)/hello.sfc
	$(MESEN) --testrunner $(BUILD)/hello.sfc test/hello.lua

# ---- M2: 68000-core parity ROM (drive via ../core-c/tests/parity_snes.sh) ----
# m68k.c + parity glue compile at -O0 (the Calypsi correctness baseline, per
# snespico8). parity_ref.h is generated by the host run in parity_snes.sh.
M68INC := -I../core-c/src -I../core-c/tests
M68CFLAGS := --core=65816 --target=snes $(MODEL) --no-ppu-mul -O0 $(M68INC)

$(BUILD)/m68k.o: ../core-c/src/m68k.c ../core-c/src/m68k.h | $(BUILD)
	$(CC) -o $@ ../core-c/src/m68k.c $(M68CFLAGS) --list-file=$(@:.o=.lst)

$(BUILD)/parity.o: parity.c ../core-c/tests/parity_run.h ../core-c/tests/parity_stream.h ../core-c/tests/parity_ref.h calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ parity.c $(M68CFLAGS) --list-file=$(@:.o=.lst)

$(BUILD)/parity.raw: $(BUILD)/header.o $(BUILD)/mailbox.o $(BUILD)/m68k.o $(BUILD)/parity.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/parity.map $^

$(BUILD)/parity.sfc: $(BUILD)/parity.raw tools/raw2sfc.py
	python3 tools/raw2sfc.py $< $@

.PHONY: parity test-parity
parity: $(BUILD)/parity.sfc
test-parity: $(BUILD)/parity.sfc
	$(MESEN) --testrunner $(BUILD)/parity.sfc test/parity.lua

# ---- M4: display a captured Mac framebuffer on the SNES ----
# macfb_tiles.h is generated by the host mkmacfb tool from the (gitignored) ROM.
$(BUILD)/mkmacfb: ../core-c/src/mkmacfb.c ../core-c/src/mac.c ../core-c/src/m68k.c | $(BUILD)
	cc -O2 -std=c11 -I../core-c/src -o $@ ../core-c/src/mkmacfb.c ../core-c/src/mac.c ../core-c/src/m68k.c
$(BUILD)/macfb_tiles.h: $(BUILD)/mkmacfb ../roms/mac128k.rom
	$(BUILD)/mkmacfb ../roms/mac128k.rom > $@ 2>/dev/null

$(BUILD)/macvideo.o: macvideo.c $(BUILD)/macfb_tiles.h calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ macvideo.c $(CFLAGS) -I$(BUILD)
$(BUILD)/macvideo.raw: $(BUILD)/header.o $(BUILD)/mailbox.o $(BUILD)/macvideo.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/macvideo.map $^
$(BUILD)/macvideo.sfc: $(BUILD)/macvideo.raw tools/raw2sfc.py
	python3 tools/raw2sfc.py $< $@
.PHONY: macvideo test-macvideo
macvideo: $(BUILD)/macvideo.sfc
test-macvideo: $(BUILD)/macvideo.sfc
	$(MESEN) --testrunner $(BUILD)/macvideo.sfc test/macvideo.lua

# ---- M4b: the live Mac machine model on the SNES ----
# mac.c compiled -DMAC_SNES: RAM in cart SRAM, ROM/disk embedded in cart ROM
# (macmem.c). First a parity check vs the host (macparity), then the full boot.
# -O2 for speed (the live boot is unusably slow at the -O0 correctness baseline);
# the parity run re-validates correctness at -O2. The 68000 core is the hot path,
# so it gets its own optimized object (macm68k.o) rather than the M2 -O0 one.
MACSNES_CFLAGS := --core=65816 --target=snes $(MODEL) --no-ppu-mul -O2 -DMAC_SNES -I. $(M68INC) -I$(BUILD)
MACP_N ?= 20000

$(BUILD)/macheader.o: calypsi/macheader.s | $(BUILD)
	$(AS) -o $@ $< $(AFLAGS)
$(BUILD)/macm68k.o: ../core-c/src/m68k.c ../core-c/src/m68k.h | $(BUILD)
	$(CC) -o $@ ../core-c/src/m68k.c $(MACSNES_CFLAGS) --list-file=$(@:.o=.lst)
$(BUILD)/mac.o: ../core-c/src/mac.c ../core-c/src/mac.h ../core-c/src/m68k.h | $(BUILD)
	$(CC) -o $@ ../core-c/src/mac.c $(MACSNES_CFLAGS) --list-file=$(@:.o=.lst)
$(BUILD)/macmem.o: macmem.c | $(BUILD)
	$(CC) -o $@ macmem.c $(MACSNES_CFLAGS) --list-file=$(@:.o=.lst)

# host reference: boot N steps, emit the CPU/RAM hashes the SNES must match
$(BUILD)/macgenref: ../core-c/tests/macgenref.c ../core-c/src/mac.c ../core-c/src/m68k.c ../core-c/tests/macparity_hash.h | $(BUILD)
	cc -O2 -std=c11 -I../core-c/src -I../core-c/tests -o $@ ../core-c/tests/macgenref.c ../core-c/src/mac.c ../core-c/src/m68k.c
$(BUILD)/macparity_ref.h: $(BUILD)/macgenref ../roms/mac128k.rom
	$(BUILD)/macgenref ../roms/mac128k.rom $(MACP_N) > $@

$(BUILD)/macparity.o: macparity.c $(BUILD)/macparity_ref.h ../core-c/tests/macparity_hash.h calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ macparity.c $(MACSNES_CFLAGS) --list-file=$(@:.o=.lst)
$(BUILD)/macparity.raw: $(BUILD)/macheader.o $(BUILD)/mailbox.o $(BUILD)/macm68k.o $(BUILD)/mac.o $(BUILD)/macmem.o $(BUILD)/macparity.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/macparity.map $^
$(BUILD)/macparity.sfc: $(BUILD)/macparity.raw tools/raw2sfc.py ../roms/mac128k.rom
	python3 tools/raw2sfc.py $< $@ --at 0x080000 ../roms/mac128k.rom

.PHONY: macparity test-macparity
macparity: $(BUILD)/macparity.sfc
test-macparity: $(BUILD)/macparity.sfc
	$(MESEN) --testrunner $(BUILD)/macparity.sfc test/macparity.lua

clean:
	rm -rf $(BUILD)
