# snesmac SNES-side build. Calypsi C -> 65816, same toolchain as snespico8.
# M0: hello (prove the build plumbing). Later: the 68000 core (Musashi via
# Calypsi) + the Mac machine glue.
#
# Reuses snespico8's vendored Calypsi install for now (override CALDIR to point
# elsewhere once snesmac vendors its own).
CALDIR ?= ../../snespico8/tools/calypsi-65816-5.17
CC := $(CALDIR)/bin/cc65816
AS := $(CALDIR)/bin/as65816
LN := $(CALDIR)/bin/ln65816
MESEN := /Applications/Mesen.app/Contents/MacOS/Mesen
BUILD := build

MODEL := --code-model=large --data-model=large
OPT ?= -O2
CFLAGS = --core=65816 --target=snes $(MODEL) --no-ppu-mul $(OPT) -I. --list-file=$(@:.o=.lst)
AFLAGS := --core=65816 --target=SNES $(MODEL)
LNFLAGS := calypsi/linker.scm --output-format=raw --rtattr exit=simplified \
           $(CALDIR)/lib/clib-lc-ld-snes-noppu.a

.PHONY: hello test-hello clean
hello: $(BUILD)/hello.sfc

$(BUILD):
	mkdir -p $(BUILD)

$(BUILD)/header.o: calypsi/header.s | $(BUILD)
	$(AS) -o $@ $< $(AFLAGS)

$(BUILD)/mailbox.o: calypsi/mailbox.c calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ $< $(CFLAGS)

$(BUILD)/hello.o: hello.c calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ $< $(CFLAGS)

$(BUILD)/hello.raw: $(BUILD)/header.o $(BUILD)/mailbox.o $(BUILD)/hello.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/hello.map $^

$(BUILD)/hello.sfc: $(BUILD)/hello.raw tools/raw2sfc.py
	python3 tools/raw2sfc.py $< $@

test-hello: $(BUILD)/hello.sfc
	$(MESEN) --testrunner $(BUILD)/hello.sfc test/hello.lua

# ---- M2: 68000-core parity ROM (drive via ../core-c/tests/parity_snes.sh) ----
# m68k.c + parity glue compile at -O0 (the Calypsi correctness baseline, per
# snespico8). parity_ref.h is generated by the host run in parity_snes.sh.
M68INC := -I../core-c/src -I../core-c/tests
M68CFLAGS := --core=65816 --target=snes $(MODEL) --no-ppu-mul -O0 $(M68INC)

$(BUILD)/m68k.o: ../core-c/src/m68k.c ../core-c/src/m68k.h | $(BUILD)
	$(CC) -o $@ ../core-c/src/m68k.c $(M68CFLAGS) --list-file=$(@:.o=.lst)

$(BUILD)/parity.o: parity.c ../core-c/tests/parity_run.h ../core-c/tests/parity_stream.h ../core-c/tests/parity_ref.h calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ parity.c $(M68CFLAGS) --list-file=$(@:.o=.lst)

$(BUILD)/parity.raw: $(BUILD)/header.o $(BUILD)/mailbox.o $(BUILD)/m68k.o $(BUILD)/parity.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/parity.map $^

$(BUILD)/parity.sfc: $(BUILD)/parity.raw tools/raw2sfc.py
	python3 tools/raw2sfc.py $< $@

.PHONY: parity test-parity
parity: $(BUILD)/parity.sfc
test-parity: $(BUILD)/parity.sfc
	$(MESEN) --testrunner $(BUILD)/parity.sfc test/parity.lua

# ---- M4: display a captured Mac framebuffer on the SNES ----
# macfb_tiles.h is generated by the host mkmacfb tool from the (gitignored) ROM.
$(BUILD)/mkmacfb: ../core-c/src/mkmacfb.c ../core-c/src/mac.c ../core-c/src/m68k.c | $(BUILD)
	cc -O2 -std=c11 -I../core-c/src -o $@ ../core-c/src/mkmacfb.c ../core-c/src/mac.c ../core-c/src/m68k.c
$(BUILD)/macfb_tiles.h: $(BUILD)/mkmacfb ../roms/mac128k.rom
	$(BUILD)/mkmacfb ../roms/mac128k.rom > $@ 2>/dev/null

$(BUILD)/macvideo.o: macvideo.c $(BUILD)/macfb_tiles.h calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ macvideo.c $(CFLAGS) -I$(BUILD)
$(BUILD)/macvideo.raw: $(BUILD)/header.o $(BUILD)/mailbox.o $(BUILD)/macvideo.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/macvideo.map $^
$(BUILD)/macvideo.sfc: $(BUILD)/macvideo.raw tools/raw2sfc.py
	python3 tools/raw2sfc.py $< $@
.PHONY: macvideo test-macvideo
macvideo: $(BUILD)/macvideo.sfc
test-macvideo: $(BUILD)/macvideo.sfc
	$(MESEN) --testrunner $(BUILD)/macvideo.sfc test/macvideo.lua

# ---- M4b: the live Mac machine model on the SNES ----
# mac.c compiled -DMAC_SNES: RAM in cart SRAM, ROM/disk embedded in cart ROM
# (macmem.c). First a parity check vs the host (macparity), then the full boot.
# -O2 for speed (the live boot is unusably slow at the -O0 correctness baseline);
# the parity run re-validates correctness at -O2. The 68000 core is the hot path,
# so it gets its own optimized object (macm68k.o) rather than the M2 -O0 one.
# -O2 --strong-inline: +2.4% measured, parity-clean (profiler round item 4).
# Measured and rejected (docs/PERF.md item G): --no-cross-call buys 0 frames,
# and --speed MISCOMPILES the machine build (real-ROM boot derails ~step 768
# — the bench alone didn't catch it; the parity gate did).
MACSNES_CFLAGS := --core=65816 --target=snes $(MODEL) --no-ppu-mul -O2 --strong-inline -DMAC_SNES -I. $(M68INC) -I$(BUILD)
MACP_N ?= 500

$(BUILD)/macheader.o: calypsi/macheader.s | $(BUILD)
	$(AS) -o $@ $< $(AFLAGS)
$(BUILD)/macmailbox.o: calypsi/mailbox.c calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ calypsi/mailbox.c $(MACSNES_CFLAGS) --list-file=$(@:.o=.lst)
$(BUILD)/tilecopy.o: calypsi/tilecopy.s | $(BUILD)
	$(AS) -o $@ $< $(AFLAGS)
$(BUILD)/m68krun.o: calypsi/m68krun.s | $(BUILD)
	$(AS) -o $@ $< $(AFLAGS)
$(BUILD)/macm68k.o: ../core-c/src/m68k.c ../core-c/src/m68k.h m68kbus.h macmem.h | $(BUILD)
	$(CC) -o $@ ../core-c/src/m68k.c $(MACSNES_CFLAGS) -DM68K_BUS_INLINE --list-file=$(@:.o=.lst)
$(BUILD)/mac.o: ../core-c/src/mac.c ../core-c/src/mac.h ../core-c/src/m68k.h macmem.h | $(BUILD)
	$(CC) -o $@ ../core-c/src/mac.c $(MACSNES_CFLAGS) --list-file=$(@:.o=.lst)
# host reference: boot N steps, emit the CPU/RAM hashes the SNES must match
$(BUILD)/macgenref: ../core-c/tests/macgenref.c ../core-c/src/mac.c ../core-c/src/m68k.c ../core-c/tests/macparity_hash.h | $(BUILD)
	cc -O2 -std=c11 -I../core-c/src -I../core-c/tests -o $@ ../core-c/tests/macgenref.c ../core-c/src/mac.c ../core-c/src/m68k.c
$(BUILD)/macparity_ref.h: $(BUILD)/macgenref ../roms/mac128k.rom
	$(BUILD)/macgenref ../roms/mac128k.rom $(MACP_N) > $@

$(BUILD)/macparity.o: macparity.c $(BUILD)/macparity_ref.h ../core-c/tests/macparity_hash.h calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ macparity.c $(MACSNES_CFLAGS) --list-file=$(@:.o=.lst)
$(BUILD)/macparity.raw: $(BUILD)/macheader.o $(BUILD)/tilecopy.o $(BUILD)/m68krun.o $(BUILD)/macmailbox.o $(BUILD)/macm68k.o $(BUILD)/mac.o $(BUILD)/macparity.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/macparity.map $^
$(BUILD)/macparity.sfc: $(BUILD)/macparity.raw tools/raw2sfc.py ../roms/mac128k.rom
	python3 tools/raw2sfc.py $< $@ --at 0x080000 ../roms/mac128k.rom

.PHONY: macparity test-macparity
macparity: $(BUILD)/macparity.sfc
test-macparity: $(BUILD)/macparity.sfc
	$(MESEN) --testrunner $(BUILD)/macparity.sfc test/macparity.lua

# Same source, -DMACP_HOT: steps the real ROM through the hand-65816 inner loop
# (m68k_run_hot) instead of the C core, so it validates the ASM native handlers
# on real boot code — the coverage the bench's DBRA/BRA-only branches can't give.
# Checks against the SAME host reference (macparity_ref.h).
$(BUILD)/macparityhot.o: macparity.c $(BUILD)/macparity_ref.h ../core-c/tests/macparity_hash.h calypsi/mailbox.h | $(BUILD)
	$(CC) -o $@ macparity.c $(MACSNES_CFLAGS) -DMACP_HOT --list-file=$(@:.o=.lst)
$(BUILD)/macparityhot.raw: $(BUILD)/macheader.o $(BUILD)/tilecopy.o $(BUILD)/m68krun.o $(BUILD)/macmailbox.o $(BUILD)/macm68k.o $(BUILD)/mac.o $(BUILD)/macparityhot.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/macparityhot.map $^
$(BUILD)/macparityhot.sfc: $(BUILD)/macparityhot.raw tools/raw2sfc.py ../roms/mac128k.rom
	python3 tools/raw2sfc.py $< $@ --at 0x080000 ../roms/mac128k.rom

.PHONY: macparity-hot test-macparity-hot
macparity-hot: $(BUILD)/macparityhot.sfc
test-macparity-hot: $(BUILD)/macparityhot.sfc
	$(MESEN) --testrunner $(BUILD)/macparityhot.sfc test/macparity.lua

# ---- bench: OUR OWN 68000 ROM (bench/mkbenchrom.py — no Apple bytes) ----
# benchhost prints the golden per-phase instruction counts + CRC; macbench runs
# the same ROM on the SNES and test/macbench.lua stamps frames per phase.
# See docs/PERF.md. test-bench asserts host CRC == SNES CRC.
$(BUILD)/benchrom.bin: ../bench/mkbenchrom.py | $(BUILD)
	python3 ../bench/mkbenchrom.py $@
$(BUILD)/benchhost: ../core-c/tests/benchhost.c ../core-c/src/mac.c ../core-c/src/m68k.c | $(BUILD)
	cc -O2 -std=c11 -I../core-c/src -o $@ ../core-c/tests/benchhost.c ../core-c/src/mac.c ../core-c/src/m68k.c
$(BUILD)/macbench.o: macbench.c calypsi/mailbox.h ../core-c/src/mac.h | $(BUILD)
	$(CC) -o $@ macbench.c $(MACSNES_CFLAGS) --list-file=$(@:.o=.lst)
$(BUILD)/macbench.raw: $(BUILD)/macheader.o $(BUILD)/tilecopy.o $(BUILD)/m68krun.o $(BUILD)/macmailbox.o $(BUILD)/macm68k.o $(BUILD)/mac.o $(BUILD)/macbench.o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/macbench.map $^
$(BUILD)/macbench.sfc: $(BUILD)/macbench.raw tools/raw2sfc.py $(BUILD)/benchrom.bin
	python3 tools/raw2sfc.py $< $@ --at 0x080000 $(BUILD)/benchrom.bin

.PHONY: macbench bench-host test-bench
macbench: $(BUILD)/macbench.sfc
bench-host: $(BUILD)/benchhost $(BUILD)/benchrom.bin
	$(BUILD)/benchhost $(BUILD)/benchrom.bin
test-bench: $(BUILD)/macbench.sfc $(BUILD)/benchhost
	$(BUILD)/benchhost $(BUILD)/benchrom.bin | tee $(BUILD)/bench_host.txt
	$(MESEN) --testrunner $(BUILD)/macbench.sfc test/macbench.lua | tee $(BUILD)/bench_snes.txt
	@h=$$(grep '^CRC' $(BUILD)/bench_host.txt | awk '{print $$2}' | tr 'A-F' 'a-f'); \
	 s=$$(grep 'OUT CRC' $(BUILD)/bench_snes.txt | awk '{print $$3}' | tr 'A-F' 'a-f'); \
	 if [ -n "$$h" ] && [ "$$h" = "$$s" ]; then echo "BENCH CRC MATCH $$h"; \
	 else echo "BENCH CRC MISMATCH host=$$h snes=$$s"; exit 1; fi

# ---- the live boot: run the machine + draw the framebuffer, disk embedded ----
# FASTBOOT=1 (default): skip the ROM's ~1.5M-instruction RAM test + boot-chime
# delay by teleporting to a host-generated warm state (macfastboot_gen), and
# HLE _BlockMove as a C-speed copy — docs/PERF.md items I1/I2. Both are
# faithfulness trades gated on MAC_FASTBOOT; build FASTBOOT=0 for the purist
# boot. The warm state is generated from the user's own ROM+disk at build
# time (like macparity_ref.h) and never committed.
FASTBOOT ?= 1
# TELEPORT picks WHERE fastboot lands: `boot` (default) stops at the first disk
# read, so you still watch Happy Mac -> Welcome -> Finder; `desktop` runs on to
# the settled Finder desktop, so power-on jumps straight there in seconds.
TELEPORT ?= boot
DISK2 := $(wildcard ../roms/disk2_data.bin)
ifneq ($(DISK2),)
DISK2_FLAG := -DDISK2_SIZE=$(shell stat -f%z $(DISK2))ul
DISK2_BLOB := --at 0x200000 $(DISK2)
endif
# The warm state and the object that embeds it carry the mode in their FILENAMES
# (macfb_boot.* / macfb_desktop.*), so flipping TELEPORT selects different build
# targets — no reliance on mtimes (Apple's make has 1-second granularity, which
# silently kept a stale state when the two modes were the same fixed filename).
$(BUILD)/macfbgen: ../core-c/tests/macfastboot_gen.c ../core-c/src/mac.c ../core-c/src/m68k.c | $(BUILD)
	cc -O2 -std=c11 -I../core-c/src -o $@ ../core-c/tests/macfastboot_gen.c ../core-c/src/mac.c ../core-c/src/m68k.c
$(BUILD)/macfb_%.h $(BUILD)/macfb_%.bin: $(BUILD)/macfbgen ../roms/mac128k.rom ../roms/sys11_data.bin $(DISK2) | $(BUILD)
	$(BUILD)/macfbgen ../roms/mac128k.rom ../roms/sys11_data.bin $(BUILD)/macfb_$*.h $(BUILD)/macfb_$*.bin $* $(DISK2)
$(BUILD)/macfast_$(TELEPORT).o: ../core-c/src/mac.c ../core-c/src/mac.h ../core-c/src/m68k.h macmem.h $(BUILD)/macfb_$(TELEPORT).h | $(BUILD)
	$(CC) -o $@ ../core-c/src/mac.c $(MACSNES_CFLAGS) -DMAC_FASTBOOT -DMACFB_REF='"macfb_$(TELEPORT).h"' --list-file=$(@:.o=.lst)

ifeq ($(FASTBOOT),1)
# MACVARIANT names the whole build (boot / desktop / off) so every downstream
# object and the .sfc are mode-specific files — switching modes selects a
# different target rather than overwriting a fixed name (which went stale under
# 1-second mtimes). `macboot` copies the chosen variant to build/macboot.sfc.
MACVARIANT := $(TELEPORT)
MACBOOT_MACO := $(BUILD)/macfast_$(TELEPORT).o
MACBOOT_FLAG := -DMAC_FASTBOOT
MACBOOT_BLOB := --at 0x180000 $(BUILD)/macfb_$(TELEPORT).bin
MACBOOT_DEPS := $(BUILD)/macfb_$(TELEPORT).bin
else
MACVARIANT := off
MACBOOT_MACO := $(BUILD)/mac.o
MACBOOT_FLAG :=
MACBOOT_BLOB :=
MACBOOT_DEPS :=
endif

$(BUILD)/maczoom_tab.h: tools/mkzoomtab.py | $(BUILD)
	python3 tools/mkzoomtab.py $@
$(BUILD)/mackbd_tab.h: tools/mkkbd.py tools/font8x8_basic.h | $(BUILD)
	python3 tools/mkkbd.py $@
$(BUILD)/macboot_$(MACVARIANT).o: macboot.c calypsi/mailbox.h ../core-c/src/mac.h $(BUILD)/maczoom_tab.h $(BUILD)/mackbd_tab.h | $(BUILD)
	$(CC) -o $@ macboot.c $(MACSNES_CFLAGS) $(MACBOOT_FLAG) $(DISK2_FLAG) --list-file=$(@:.o=.lst)
$(BUILD)/macboot_$(MACVARIANT).raw: $(BUILD)/macheader.o $(BUILD)/tilecopy.o $(BUILD)/m68krun.o $(BUILD)/macmailbox.o $(BUILD)/macm68k.o $(MACBOOT_MACO) $(BUILD)/macboot_$(MACVARIANT).o
	$(LN) -o $@ $(LNFLAGS) --list-file=$(BUILD)/macboot_$(MACVARIANT).map $^
$(BUILD)/macboot_$(MACVARIANT).sfc: $(BUILD)/macboot_$(MACVARIANT).raw tools/raw2sfc.py ../roms/mac128k.rom ../roms/sys11_data.bin $(MACBOOT_DEPS) $(DISK2)
	python3 tools/raw2sfc.py $< $@ --at 0x080000 ../roms/mac128k.rom --at 0x100000 ../roms/sys11_data.bin $(MACBOOT_BLOB) $(DISK2_BLOB)

.PHONY: macboot macboot-desktop macboot-purist test-macboot
macboot: $(BUILD)/macboot_$(MACVARIANT).sfc         # boot teleport (watch it boot)
	@cp $< $(BUILD)/macboot.sfc && echo "  build/macboot.sfc  <- $(MACVARIANT)"
macboot-desktop:                                    # teleport straight to the Finder
	@$(MAKE) macboot TELEPORT=desktop
macboot-purist:                                     # faithful power-on, no teleport
	@$(MAKE) macboot FASTBOOT=0
test-macboot: $(BUILD)/macboot_$(MACVARIANT).sfc
	@cp $< $(BUILD)/macboot.sfc
	$(MESEN) --testrunner $(BUILD)/macboot.sfc test/macboot.lua

clean:
	rm -rf $(BUILD)
